{
  "id": "cheaperinference",
  "name": "Cheaper Inference",
  "description": "Cheaper Inference model provider (OpenAI-compatible API)",
  "categories": ["models"],
  "activation": {
    "onStartup": false
  },
  "providers": ["cheaperinference"],
  "setup": {
    "providers": [
      {
        "id": "cheaperinference",
        "authMethods": ["api-key"],
        "envVars": ["CHEAPER_INFERENCE_API_KEY"]
      }
    ]
